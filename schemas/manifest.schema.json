{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Skills Manifest",
  "description": "Tool-agnostic catalog of skills in this repository",
  "type": "object",
  "required": ["name", "version", "skills"],
  "properties": {
    "name": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string" },
    "author": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      ]
    },
    "repository": { "type": "string" },
    "license": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of skill directory names under skills/"
    }
  },
  "additionalProperties": false
}
