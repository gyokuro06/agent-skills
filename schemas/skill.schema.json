{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Frontmatter",
  "description": "YAML frontmatter schema for SKILL.md files",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique skill identifier (kebab-case)"
    },
    "description": {
      "type": "string",
      "description": "One-line summary shown in skill listings"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "origin": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
